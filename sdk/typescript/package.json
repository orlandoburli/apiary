{
  "name": "@apiary/plugin",
  "version": "1.0.0",
  "description": "Official TypeScript/Node SDK for Apiary plugins (protocol 1)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
