{
  "name": "vscode-apiary",
  "displayName": "Apiary Workflow Editor",
  "description": "Bidirectional visual editor and live preview for canonical apiary.yaml workflows",
  "version": "0.2.0",
  "publisher": "orlandoburli",
  "license": "BSD-3-Clause",
  "icon": "icon.png",
  "homepage": "https://orlandoburli.com.br/apiary/",
  "repository": {
    "type": "git",
    "url": "https://github.com/orlandoburli/apiary"
  },
  "bugs": {
    "url": "https://github.com/orlandoburli/apiary/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "apiary",
    "workflow",
    "yaml",
    "preview",
    "diagram"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apiary.showPreview",
        "title": "Apiary: Open Workflow Editor",
        "icon": "$(type-hierarchy-super)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "apiary.showPreview",
          "when": "resourceFilename == apiary.yaml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Apiary",
      "properties": {
        "apiary.executablePath": {
          "type": "string",
          "default": "apiary",
          "description": "Apiary executable used by visual editor Validate and Dry Run actions"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --target=node18 --format=cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "watch": "npm run build -- --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
